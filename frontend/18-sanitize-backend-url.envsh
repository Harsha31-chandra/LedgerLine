#!/bin/sh
# LedgerLine — Runtime Environment Sanitization for Nginx
# Strips any accidental trailing slashes from BACKEND_PUBLIC_URL to prevent Nginx proxy_pass syntax errors
while [ "${BACKEND_PUBLIC_URL%/}" != "$BACKEND_PUBLIC_URL" ]; do
    BACKEND_PUBLIC_URL="${BACKEND_PUBLIC_URL%/}"
done
export BACKEND_PUBLIC_URL

# Auto-detect resolver from /etc/resolv.conf if not explicitly provided
if [ -z "${DNS_RESOLVER:-}" ]; then
    DNS_RESOLVER=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf)
    DNS_RESOLVER="${DNS_RESOLVER% }"
fi
export DNS_RESOLVER="${DNS_RESOLVER:-127.0.0.11}"
