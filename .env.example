# ── LedgerLine Environment Variables ──
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Application runtime database (must connect using dedicated unprivileged role ledgerline_app)
APP_DATABASE_URL=postgresql://ledgerline_app:ledgerline_app_dev@localhost:5432/ledgerline
DATABASE_URL=postgresql://ledgerline_app:ledgerline_app_dev@localhost:5432/ledgerline

# Test database (exclusively for automated test execution; never points to ledgerline)
TEST_DATABASE_URL=postgresql://ledgerline_migrator:ledgerline_migrator_dev@localhost:5432/ledgerline_test
APP_TEST_DATABASE_URL=postgresql://ledgerline_app:ledgerline_app_dev@localhost:5432/ledgerline_test

# Migration database (must be explicitly provided for Alembic commands; connects as dedicated migration role ledgerline_migrator)
# During initial development, migrations must target ledgerline_test on localhost:5432
MIGRATION_DATABASE_URL=postgresql://ledgerline_migrator:ledgerline_migrator_dev@localhost:5432/ledgerline_test

# Session security — replace with a long random string in production
SESSION_SECRET=change-me-to-a-random-string

# Application environment: development | production
APP_ENV=development

# Production database allowlists (REQUIRED when APP_ENV=production; fails closed if omitted)
# In production, runtime and migration connections require explicit host and database allowlists.
# Test databases (*_test) are strictly rejected in production.
# DB_ALLOWED_HOSTS=db.internal.example.com
# DB_ALLOWED_DATABASES=ledgerline_prod
# DB_ALLOWED_PORTS=5432

# Comma-separated allowed origins for CORS and CSRF protection
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000,http://[::1]:8000

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# ── Docker Compose & Container Orchestration ──
# Database container credentials (used by docker-compose)
POSTGRES_USER=ledgerline
POSTGRES_PASSWORD=ledgerline_dev
POSTGRES_DB=ledgerline
DB_PORT=5432

# Role credentials used by backend container and migration runner
DB_APP_PASSWORD=ledgerline_app_dev
DB_MIGRATOR_PASSWORD=ledgerline_migrator_dev

# Container published port mapping
BACKEND_PORT=8000
FRONTEND_PORT=3000
