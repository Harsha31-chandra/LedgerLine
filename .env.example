# ── LedgerLine Environment Variables ──
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Application runtime database (development only; never used for tests or initial migrations)
DATABASE_URL=postgresql://ledgerline:ledgerline_dev@localhost:5432/ledgerline

# Test database (exclusively for automated test execution; never points to ledgerline)
TEST_DATABASE_URL=postgresql://ledgerline:ledgerline_dev@localhost:5432/ledgerline_test

# Migration database (must be explicitly provided for Alembic commands; never falls back to DATABASE_URL)
# During initial development, migrations must target ledgerline_test on localhost:5432
MIGRATION_DATABASE_URL=postgresql://ledgerline:ledgerline_dev@localhost:5432/ledgerline_test

# Session security — replace with a long random string in production
SESSION_SECRET=change-me-to-a-random-string

# Application environment: development | production
APP_ENV=development

# Comma-separated allowed origins for CORS and CSRF protection
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000,http://[::1]:8000

# Set to true when serving over HTTPS
COOKIE_SECURE=false
