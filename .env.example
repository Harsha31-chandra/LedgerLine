# ── LedgerLine Environment Variables ──
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://ledgerline:ledgerline_dev@localhost:5432/ledgerline
TEST_DATABASE_URL=postgresql://ledgerline:ledgerline_dev@localhost:5432/ledgerline_test

# Session security — replace with a long random string in production
SESSION_SECRET=change-me-to-a-random-string

# Application environment: development | production
APP_ENV=development

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# Set to true when serving over HTTPS
COOKIE_SECURE=false
